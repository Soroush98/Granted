# Copy to services/scraper/.env and fill in real values.

# --- Supabase ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...                  # bypasses RLS — server only

# Direct Postgres URL (with the DB password). Used by the dev / maintenance
# scripts that hit the DB directly (entity-resolution audits, rate-limit
# resets). Find this in Supabase → Project Settings → Database → URI.
SUPABASE_DB_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# --- Embeddings (Voyage AI) ---
# 1024-dim voyage-3.5. Sign up at voyageai.com for an API key.
VOYAGE_API_KEY=pa-...
VOYAGE_EMBED_MODEL=voyage-3.5

# --- Legacy Ollama config (kept for the local-LLM rerank path) ---
# The web app now uses Claude for reranking (see apps/web/.env.local). These
# variables are still honored by services/scraper/scraper/ollama.py if you
# want to call a local model for ingest-time classification experiments.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text                # legacy; embeddings now via Voyage

# --- Polite scraping (Scale AI press releases, ERA / Alberta Innovates sitemaps) ---
SCRAPER_USER_AGENT=GrantedBot/0.1 (+https://granted.example/bot)
SCRAPER_CONCURRENCY=4

# --- OpenAlex (optional, future use) ---
# Polite-pool email for OpenAlex API. Required only if you add OpenAlex
# enrichment to the ingest pipeline.
OPENALEX_MAILTO=you@example.com

# --- Cache-revalidation webhook (scraper → web app /api/revalidate) ---
# Must match REVALIDATE_SECRET in apps/web/.env.local.
WEB_BASE_URL=http://localhost:3000
REVALIDATE_SECRET=changeme
