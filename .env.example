# Copy to apps/web/.env.local and fill in real values.

# --- Supabase (Postgres + pgvector + tsvector) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # server-only — never expose to the client

# --- Voyage AI (embeddings) ---
# 1024-dim voyage-3.5 vectors stored in pgvector. Get a key at voyageai.com.
VOYAGE_API_KEY=pa-...
VOYAGE_EMBED_MODEL=voyage-3.5

# --- Anthropic (Claude rerank step) ---
# Claude Haiku 4.5 reranks the top-10 hybrid candidates with a one-sentence
# rationale per match. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Cache-revalidation webhook (scraper → /api/revalidate) ---
# Must match the same key in services/scraper/.env. Generate a strong random
# value, e.g. `openssl rand -hex 32`. If unset, /api/revalidate is DISABLED
# (rejects all requests) rather than falling back to a guessable default.
REVALIDATE_SECRET=

# --- Origin lock (Cloudflare → Vercel) ---
# Rejects AI-search requests that hit the Vercel origin directly, bypassing the
# Cloudflare WAF and forging cf-connecting-ip (which would let an attacker rotate
# fake IPs past the per-IP rate limits and run up your Voyage/Claude bill).
# Must MATCH origin_verify_secret in infra/cloudflare. LEAVE UNSET until the
# Cloudflare header rule is live and verified — when unset the lock is disabled.
# Generate with `openssl rand -hex 32`.
ORIGIN_VERIFY_SECRET=
